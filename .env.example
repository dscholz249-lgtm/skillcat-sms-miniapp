# Server
PORT=3000
PUBLIC_BASE_URL=https://your-miniapp.up.railway.app

# Twilio — Messaging Service (not a bare from-number)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic — Haiku for cheap/fast intent parsing
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Platform (the deployed mock for testing)
PLATFORM_BASE_URL=https://skillcat-demo-production.up.railway.app
COMPANY_ID=co_test

# Test convenience — your verified phone (the opt-in manager in mock seed)
TEST_MANAGER_PHONE=+1XXXXXXXXXX

# Logbook dashboard address staff sign in at (custom domain). Used for the
# "Mark complete" link in Slack request notifications. Falls back to NEXTJS_URL.
LOGBOOK_PUBLIC_URL=https://logbook.skillcatlabs.com

# Second incoming webhook, bound to #experiment-notifications. Every request
# also goes there spelled out (type, what to do, link) with an @-mention of
# SLACK_MENTION_USER_ID (Slack member ID; defaults to Dan's). Optional.
SLACK_EXPERIMENT_WEBHOOK_URL=
SLACK_MENTION_USER_ID=U0B65LV46MA
